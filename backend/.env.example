# Copy this file to .env and fill in your SMTP credentials.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=your-email@gmail.com

# Local Redis configuration.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s
REDIS_SSL=false

# Google login (Google Cloud Console > Credentials > OAuth client ID, type "Web application").
# Add Authorized redirect URI: http://localhost:8081/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public frontend origin: the browser is sent back here after the Google callback.
FRONTEND_BASE_URL=http://localhost:5173

# Shared secret with the frontend SSR server (same value as INTERNAL_PROXY_SECRET in
# frontend/.env, at least 32 characters). Only requests carrying it may forward the
# browser's IP/User-Agent. Required in production: without it every user behind the SSR
# server shares one rate-limit identity. Generate with: openssl rand -base64 48
INTERNAL_PROXY_SECRET=
