# Caddy tự xin và gia hạn chứng chỉ HTTPS (Let's Encrypt) cho $DOMAIN,
# tự chuyển hướng HTTP → HTTPS và gắn X-Forwarded-For cho frontend.

(security) {
    header {
        # Thêm header bảo mật
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        # Xóa header lộ thông tin (dấu trừ = xóa)
        -Server
        -X-Powered-By
    }
}

{$DOMAIN} {
	encode zstd gzip
	import security
	reverse_proxy frontend:3000
}


