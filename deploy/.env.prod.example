# =====================================================================
# ProjectSale — biến môi trường production.
# Copy thành deploy/.env.prod rồi điền giá trị thật. KHÔNG commit .env.prod.
# Tạo secret ngẫu nhiên: openssl rand -base64 48
# =====================================================================

# --- Tên miền (đã trỏ bản ghi A về IP của VPS) -----------------------
DOMAIN=shop.example.com

# --- Image (chỉ dùng khi deploy thủ công) ------------------------------
# Deploy bằng GitHub Actions thì bỏ qua: workflow ghi REGISTRY/TAG vào deploy/.env.release.
REGISTRY=projectsale
TAG=latest

# --- MySQL ------------------------------------------------------------
MYSQL_DATABASE=projectsale
MYSQL_USER=projectsale
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Redis ------------------------------------------------------------
REDIS_USERNAME=projectsale
REDIS_PASSWORD=

# --- Backend ----------------------------------------------------------
# Khoá ký JWT, base64 của >= 32 byte ngẫu nhiên: openssl rand -base64 48
JWT_SECRET_BASE64=

# SMTP gửi OTP (Gmail: dùng App Password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Dùng chung backend + frontend (>= 32 ký tự) ----------------------
INTERNAL_PROXY_SECRET=

# --- Frontend ---------------------------------------------------------
# Khoá ký session cookie (>= 32 ký tự).
SESSION_SECRET=
VITE_APP_NAME=ProjectSale

# --- Giới hạn RAM từng container (tổng ≈ 1.45GB cho VPS 2GB) ----------
MYSQL_MEM_LIMIT=448m
REDIS_MEM_LIMIT=96m
BACKEND_MEM_LIMIT=640m
FRONTEND_MEM_LIMIT=224m
CADDY_MEM_LIMIT=48m
