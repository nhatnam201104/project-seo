# =====================================================================
# ProjectSale frontend — biến môi trường
# Copy sang `.env` và điền giá trị thật. KHÔNG commit `.env`.
# =====================================================================

# --- Server-only (KHÔNG lộ ra client bundle) -------------------------
# Địa chỉ Spring Boot REST API, đã gồm base path /api/v1.
API_BASE_URL=http://localhost:8080/api/v1

# Khoá ký session cookie httpOnly (chuỗi ngẫu nhiên >= 32 ký tự).
# Tạo bằng: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-secret-string

# Bật Secure flag cho cookie (true ở production/HTTPS).
COOKIE_SECURE=false

# Timeout gọi API (ms).
API_TIMEOUT_MS=15000

# --- Client-safe (được expose ra browser, phải có tiền tố VITE_) -----
VITE_APP_NAME=ProjectSale
VITE_SITE_URL=http://localhost:3000
