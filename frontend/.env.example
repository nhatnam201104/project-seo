# =====================================================================
# ProjectSale frontend — biến môi trường
# Copy sang `.env` và điền giá trị thật. KHÔNG commit `.env`.
# =====================================================================

# --- Server-only (KHÔNG lộ ra client bundle) -------------------------
# Địa chỉ Spring Boot REST API, đã gồm base path /api/v1.
API_BASE_URL=http://localhost:8081/api/v1

# Khoá ký session cookie httpOnly (chuỗi ngẫu nhiên >= 32 ký tự).
# Tạo bằng: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-secret-string

# Bật Secure flag cho cookie (true ở production/HTTPS).
COOKIE_SECURE=false

# Timeout gọi API (ms).
API_TIMEOUT_MS=15000

# Bí mật dùng chung với backend (INTERNAL_PROXY_SECRET giống hệt ở backend/.env, >= 32 ký tự).
# Chứng minh request đến từ SSR để backend tin IP/User-Agent thật của trình duyệt.
# BẮT BUỘC ở production (app từ chối khởi động nếu thiếu): không có nó, backend thấy mọi
# người dùng là một IP → rate limit khoá tất cả cùng lúc. Tạo bằng: openssl rand -base64 48
INTERNAL_PROXY_SECRET=

# Số reverse proxy (nginx/load balancer) đứng trước `npm start`. Chạy trực tiếp = 0,
# sau một nginx/LB = 1. Đặt cao hơn thực tế sẽ cho client tự khai IP qua X-Forwarded-For.
TRUST_PROXY_HOPS=0

# --- Client-safe (được expose ra browser, phải có tiền tố VITE_) -----
VITE_APP_NAME=ProjectSale
VITE_SITE_URL=http://localhost:5173
