{
  "name": "projectsale-web",
  "private": true,
  "type": "module",
  "description": "ProjectSale — Website bán mắt kính (frontend, React Router v7 framework mode + SSR)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
